CONFIG_IDF_TARGET="esp32c3"
CONFIG_BOARD_TYPE_XIAOLI_TRAE_C3=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/v2/8m.csv"
CONFIG_OTA_URL="https://xiaoli-server.fly.dev/xiaozhi/ota/"
CONFIG_LANGUAGE_ZH_CN=y
CONFIG_USE_ESP_WAKE_WORD=y
CONFIG_SR_WN_WN9S_NIHAOXIAOZHI=y
CONFIG_FLASH_DEFAULT_ASSETS=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Physical right-side buttons, top to bottom: volume up, volume down, chat.
CONFIG_XIAOLI_C3_CHAT_BUTTON=2
CONFIG_XIAOLI_C3_VOLUME_DOWN_BUTTON=1
CONFIG_XIAOLI_C3_VOLUME_UP_BUTTON=0
