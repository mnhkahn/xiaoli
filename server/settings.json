{
  "models": {
    "llm": {
      "default": "openrouter:free-router",
      "options": {
        "openrouter:free-router": {
          "name": "OpenRouter Free Router",
          "base_url": "https://openrouter.ai/api/v1",
          "model": "openrouter/free",
          "api_key_env": "OPENROUTER_API_KEY",
          "max_tokens": 8192,
          "context_length": 200000
        }
      }
    },
    "vision": {
      "base_url": "https://api.siliconflow.cn/v1/chat/completions",
      "model": "Qwen/Qwen3-VL-8B-Instruct",
      "api_key_env": "SILICONFLOW_API_KEY"
    },
    "asr": {
      "base_url": "https://api.siliconflow.cn/v1/audio/transcriptions",
      "model": "FunAudioLLM/SenseVoiceSmall",
      "api_key_env": "SILICONFLOW_API_KEY"
    },
    "tts": {
      "base_url": "https://api.siliconflow.cn/v1/audio/speech",
      "model": "FunAudioLLM/CosyVoice2-0.5B",
      "voice": "FunAudioLLM/CosyVoice2-0.5B:anna",
      "response_format": "opus",
      "api_key_env": "SILICONFLOW_API_KEY"
    }
  },
  "model_catalog": {
    "enabled": true,
    "url": "https://www.cyeam.com/v1/models",
    "refresh_interval": "0s",
    "timeout": "5s",
    "providers": {
      "openrouter": {
        "base_url": "https://openrouter.ai/api/v1",
        "api_key_env": "OPENROUTER_API_KEY",
        "max_tokens": 8192,
        "context_length": 262144,
        "id_aliases": {
          "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free": "openrouter:nemotron-3-nano-omni-30b-free",
          "nvidia/nemotron-3-super-120b-a12b:free": "openrouter:nemotron-3-super-120b-free"
        }
      },
      "siliconflow": {
        "base_url": "https://api.siliconflow.cn/v1/chat/completions",
        "api_key_env": "SILICONFLOW_API_KEY",
        "max_tokens": 8192,
        "context_length": 32768,
        "id_aliases": { "tencent/Hunyuan-MT-7B": "siliconflow:hunyuan-mt-7b" }
      }
    }
  },
  "mcp_servers": [
    {
      "name": "CYEAM",
      "url": "https://cyeam-wiki-mcp-production.up.railway.app/mcp"
    },
    {
      "name": "AMap",
      "url": "https://mcp.amap.com/mcp",
      "api_key_env": "AMAP_API_KEY"
    },
    {
      "name": "github",
      "url": "https://api.githubcopilot.com/mcp/",
      "auth_type": "bearer",
      "api_key_env": "GITHUB_PERSONAL_ACCESS_TOKEN"
    },
    {
      "name": "xiaohongshu",
      "url": "http://localhost:18060/mcp",
      "timeout": "120s"
    }
  ],
  "storage": {
    "backend": "redis",
    "redis": {
      "url_env": "XIAOLI_REDIS_URL",
      "key_prefix": "xiaoli:cp:",
      "memory_ttl_hours": 24
    },
    "local": {
      "data_dir": "~/.xiaoli",
      "memory_file": "Memory.md",
      "conversation_dir": "conversations",
      "history_max_messages": 40
    }
  },
  "a2a": {
    "enabled": true,
    "public_agent_card": false,
    "rate_limit_per_minute": 100,
    "rate_limit_global_per_minute": 1000,
    "max_concurrent": 5,
    "max_input_chars": 10000,
    "timeout_seconds": 1200,
    "task_ttl_seconds": 3600,
    "trace": {
      "enabled": true,
      "log_inputs": false,
      "log_outputs": true,
      "max_value_length": 800
    },
    "allowed_skills": [
      "holiday",
      "cyeam-cli",
      "news",
      "ai-models",
      "tv"
    ],
    "profiles": {
      "architect": {
        "model": "",
        "allow_tools": true
      },
      "geek-news": {
        "model": "",
        "allow_tools": true
      },
      "encouragement": {
        "model": "",
        "allow_tools": true
      }
    },
    "keys": [
      {
        "id": "partner_a",
        "secret_env": "A2A_PARTNER_A_SECRET"
      }
    ]
  },
  "tools": {
    "webfetch": {
      "enabled": true
    }
  },
  "chat_react": {
    "max_steps": 200,
    "timeout": "600s"
  },
  "cron": {
    "study_monitor": {
      "name": "学习状态监控",
      "description": "在设定时间窗内定时调用摄像头检查学习状态，并按需发送语音提醒和飞书通知。",
      "enabled": false,
      "trigger": {
        "every": "5m",
        "timezone": "Asia/Shanghai",
        "start_hour": 17,
        "end_hour": 21
      },
      "agent": {
        "name": "dispatch_agent",
        "mode": "react",
        "max_steps": 6,
        "timeout": "150s"
      },
      "metadata": {
        "camera_tool": "self.camera.take_photo",
        "reminder_text": "请坐直，认真学习。",
        "tool_timeout": "120s",
        "device_ids": ""
      }
    },
    "morning_greeting": {
      "name": "早安问候",
      "description": "每天早上固定时间向在线设备播放问候语；没有在线设备时跳过，不补播。",
      "enabled": true,
      "trigger": {
        "at_hour": 8,
        "at_minute": 0,
        "timezone": "Asia/Shanghai"
      },
      "agent": {
        "name": "dispatch_agent",
        "mode": "react",
        "max_steps": 4,
        "timeout": "120s"
      },
      "metadata": {
        "text": "早上好。",
        "device_ids": ""
      }
    }
  }
}
